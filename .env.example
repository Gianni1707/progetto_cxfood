# Example .env file for bot_mensa
# Copy to .env and fill the values (do NOT commit .env)

TELEGRAM_TOKEN=your_telegram_bot_token_here

# Percorsi opzionali. Se lasciati commentati, vengono usati i default in bot_mensa.py
# che mettono tutto dentro la cartella del progetto:
#   downloads/                  -> media scaricati
#   downloads/storie_archive.txt -> archivio gallery-dl (anti-duplicati)
#   cookies.txt                  -> cookie sessione Instagram
#   iscritti.json                -> elenco chat_id iscritti al bot
#   storie_log.txt               -> log
#
# DOWNLOAD_DIR=./downloads
# COOKIES_FILE=./cookies.txt
# ARCHIVE_FILE=./downloads/storie_archive.txt
# ISCRITTI_FILE=./iscritti.json
# LOG_FILE=./storie_log.txt
